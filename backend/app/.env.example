# Required: PostgreSQL connection string. Do not put this in frontend/.env.
DATABASE_URL=postgresql+psycopg2://<username>:<password>@<host>/<database>?sslmode=require

# Explicit comma-separated browser origins. Do not use * in a study deployment.
CORS_ALLOWED_ORIGINS=http://localhost:5173

# Required before exposing researcher-only HTTP or dashboard WebSocket endpoints.
RESEARCHER_API_KEY=replace-with-a-long-random-secret

# Keep DB connection use below managed PostgreSQL limits.
DB_POOL_SIZE=5
DB_MAX_OVERFLOW=5
DB_POOL_TIMEOUT_SECONDS=30
DB_POOL_RECYCLE_SECONDS=1800

# Private internal service routing. Keep these keys server-side only.
INTERNAL_SERVICE_API_KEY=replace-with-a-different-long-random-secret
ML_EXECUTION_SERVICE_URL=http://localhost:8001
AFFECT_INFERENCE_SERVICE_URL=http://localhost:8002
ML_EXECUTION_TIMEOUT_SECONDS=60
AFFECT_INFERENCE_TIMEOUT_SECONDS=15
ML_MAX_CONCURRENCY=2
AFFECT_MAX_CONCURRENCY=1
AFFECT_MAX_IMAGE_BYTES=5242880
